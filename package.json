{
  "name": "figma-ui-color-palette",
  "version": "5.3.1",
  "private": true,
  "description": "UI Color Palette is a Figma and FigJam plugin that creates, manages, exports, and publishes consistent and accessible color palettes.",
  "author": "Aurélien Grimaud",
  "license": "MIT",
  "repository": "https://github.com/a-ng-d/figma-ui-color-palette",
  "keywords": [
    "color",
    "color-scheme",
    "lch",
    "color-system",
    "ui-color",
    "figma-plugin"
  ],
  "type": "module",
  "workspaces": [
    "packages/ui-ui-color-palette",
    "packages/ui-ui-color-palette/packages/auth-yelbolt",
    "packages/ui-ui-color-palette/packages/auth-yelbolt/ui-color-palette",
    "packages/ui-ui-color-palette/packages/auth-yelbolt-worker",
    "packages/ui-ui-color-palette/packages/announcements-yelbolt-worker",
    "packages/ui-ui-color-palette/packages/cors-yelbolt-worker"
  ],
  "scripts": {
    "init:submodules": "cd packages/ui-ui-color-palette && git submodule update --init --recursive",
    "install:ext": "npm install --workspaces && npm install --workspace=packages/ui-ui-color-palette/packages/auth-yelbolt --workspaces && npm install --prefix packages/ui-ui-color-palette/packages/auth-yelbolt/ui-color-palette",
    "update:ext": "git submodule update --remote --merge",
    "update:unoff": "npm i @unoff/ui@latest @unoff/utils@latest",
    "update:uicp": "npm i @a_ng_d/utils-ui-color-palette@latest",
    "start:ext": "npm run start:ext -w ui-ui-color-palette",
    "start:dev:one": "npm run build:one",
    "start:dev:team": "npm run build:team",
    "start:dev:all": "npm run build:one & npm run build:team",
    "build:one": "cross-env PLUGIN=one npx vite build --mode development & cross-env IS_PLUGIN=true PLUGIN=one npx vite build --mode development",
    "build:team": "cross-env PLUGIN=team npx vite build --mode development & cross-env IS_PLUGIN=true PLUGIN=team npx vite build --mode development",
    "build:all": "npm run build:one & npm run build:team",
    "build:prod:one": "cross-env PLUGIN=one npx vite build --mode production && cross-env IS_PLUGIN=true PLUGIN=one npx vite build --mode production",
    "build:prod:team": "cross-env PLUGIN=team npx vite build --mode production && cross-env IS_PLUGIN=true PLUGIN=team npx vite build --mode production",
    "build:prod:all": "npm run build:prod:one & npm run build:prod:team",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint ./src/** --fix --ext .ts,.tsx .",
    "format": "npx prettier './src' --write"
  },
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "^0.15.0",
    "@figma/plugin-typings": "^1.89.0",
    "@preact/preset-vite": "^2.10.1",
    "@sentry/vite-plugin": "^3.3.1",
    "@types/chroma-js": "^3.1.1",
    "@types/file-saver": "^2.0.5",
    "@types/node": "^22.14.0",
    "@types/react": "^17.0.37",
    "@types/react-dom": "^17.0.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-react": "^7.25.3",
    "prettier": "^3.2.5",
    "prettier-plugin-css-order": "^2.1.2",
    "typescript": "^5.4.3",
    "vite": "^6.2.5",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-singlefile": "^2.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@a_ng_d/utils-ui-color-palette": "^1.8.2",
    "@mistralai/mistralai": "^1.10.0",
    "@nanostores/preact": "^0.5.2",
    "@sentry/react": "^9.27.0",
    "@supabase/supabase-js": "^2.44.2",
    "@tolgee/format-icu": "^6.2.7",
    "@tolgee/react": "^6.2.7",
    "@tolgee/web": "^6.2.7",
    "@unoff/ui": "^1.24.1",
    "@unoff/utils": "^0.8.2",
    "chroma-js": "^3.1.2",
    "color-names": "^2.0.0",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "mixpanel-figma": "^2.0.4",
    "preact": "^10.6.4",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "react-syntax-highlighter": "^15.6.1",
    "uid": "^2.0.2"
  },
  "overrides": {
    "prismjs": "^1.30.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.5"
    },
    "miniflare": {
      "undici": "^7.24.3"
    }
  }
}
